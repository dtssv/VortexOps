# =============================================================================
# VortexOps 开发环境变量模板（dev / PoC）
# 复制为 dev.env 后按需修改；生产环境请勿使用本模板默认密钥。
#   cp dev.env.template dev.env
# =============================================================================
# 所有变量通过 docker compose --env-file 注入到 docker-compose.dev.yml。
# =============================================================================

# ---------- 网络模式 ----------
# bridge (默认): k3s 在 docker bridge 网络，Pod IP 仅容器内可达
# host-net     : k3s 共享宿主机网络，macvlan 让 Pod 拿物理 LAN IP
# external     : 不启动内嵌 k3s，连接外部物理机 k3s 集群（见 up-external.sh）
K3S_NETWORK_MODE=bridge

# ---------- CNI 插件（仅 bridge 模式生效）----------
# calico (默认): 支持静态 IP 注解 cni.projectcalico.org/ipAddrs
# flannel      : 内置 vxlan，不支持静态 IP
# cilium       : eBPF 数据面，kube-proxy 替代
K3S_CNI=calico

# ---------- underlay 网络参数（仅 host-net 模式生效）----------
K3S_UNDERLAY_PARENT_IFACE=eth0
K3S_UNDERLAY_SUBNET=192.168.1.0/24
K3S_UNDERLAY_GATEWAY=192.168.1.1
K3S_UNDERLAY_RANGE_START=192.168.1.200
K3S_UNDERLAY_RANGE_END=192.168.1.250

# ---------- 外部 k3s 地址（仅 external 模式需要）----------
# VORTEXOPS_K8S_API_SERVER=https://192.168.1.10:6443

# ---------- VortexOps 应用密钥（开发用，生产严禁复用）----------
VORTEXOPS_JWT_SIGNING_KEY=dev-jwt-signing-key-at-least-32-bytes-long
VORTEXOPS_SECURITY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ---------- 数据库默认凭证（与 docker-compose.dev.yml 一致）----------
VORTEXOPS_DB_USERNAME=vortexops
VORTEXOPS_DB_PASSWORD=vortexops_dev
VORTEXOPS_DB_DATABASE=vortexops

# ---------- MinIO 默认凭证 ----------
VORTEXOPS_S3_ACCESS_KEY=admin
VORTEXOPS_S3_SECRET_KEY=vortexops_dev
VORTEXOPS_S3_BUCKET=vortexops

# ---------- Jenkins 默认凭证 ----------
VORTEXOPS_JENKINS_USER=admin
VORTEXOPS_JENKINS_PASSWORD=vortexops_dev

# ---------- 启动可选 profile ----------
# full: 同时启动 syncer / webhook / pipeline-worker
# COMPOSE_PROFILES=full
