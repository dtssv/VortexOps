# External 模式 kubeconfig 模板
# 用法：复制为 deploy/external-kubeconfig.yaml 后修改 server 地址与证书
#   cp external-kubeconfig.example ../external-kubeconfig.yaml
#
# 注意：server 地址需改为 apiserver 容器可达的 IP/域名（如物理机 IP）。
#       若集群 API Server 使用自签证书，可在 cluster 下加 insecure-skip-tls-verify: true
#       （仅开发环境，生产请使用正式 CA 签发证书）。
apiVersion: v1
kind: Config
clusters:
  - name: vortexops-external
    cluster:
      server: https://192.168.1.10:6443
      # 二选一：
      certificate-authority-data: <BASE64_ENCODED_CA>
      # insecure-skip-tls-verify: true
contexts:
  - name: vortexops-external-context
    context:
      cluster: vortexops-external
      user: vortexops-admin
      namespace: vortexops-dev
current-context: vortexops-external-context
users:
  - name: vortexops-admin
    user:
      client-certificate-data: <BASE64_ENCODED_CLIENT_CERT>
      client-key-data: <BASE64_ENCODED_CLIENT_KEY>
      # 或使用 token:
      # token: <SERVICEACCOUNT_TOKEN>
