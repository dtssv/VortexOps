{
  "_meta": { "description": "VortexOps 审计日志索引模板（匹配 vortexops-audit-*）" },
  "index_patterns": ["vortexops-audit-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.refresh_interval": "1s"
    },
    "mappings": {
      "dynamic": false,
      "properties": {
        "@timestamp":   { "type": "date" },
        "tenant_id":    { "type": "keyword" },
        "workspace_id": { "type": "keyword" },
        "user_id":      { "type": "long" },
        "user_name":    { "type": "keyword", "ignore_above": 128 },
        "operation":    { "type": "keyword", "ignore_above": 64 },
        "resource_type":{ "type": "keyword", "ignore_above": 64 },
        "resource_id":  { "type": "keyword", "ignore_above": 64 },
        "resource_name":{ "type": "text", "analyzer": "standard" },
        "ip":           { "type": "ip" },
        "user_agent":   { "type": "keyword", "ignore_above": 512 },
        "status_code":  { "type": "integer" },
        "message":      { "type": "text", "analyzer": "standard" },
        "body":         { "type": "text", "analyzer": "standard" },
        "request_id":   { "type": "keyword", "ignore_above": 64 },
        "duration_ms":  { "type": "long" }
      }
    }
  },
  "priority": 200
}
