[Unit]
Description=VortexOps Pipeline Worker
Documentation=https://github.com/vortexops/vortexops
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vortexops
Group=vortexops
WorkingDirectory=/opt/vortexops
EnvironmentFile=/etc/vortexops/vortexops.env
ExecStart=/opt/vortexops/bin/vortexops-pipeline-worker
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vortexops-pipeline-worker

LimitNOFILE=65536
TimeoutStopSec=60
KillSignal=SIGTERM

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/vortexops/logs

[Install]
WantedBy=multi-user.target
