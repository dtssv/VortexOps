# External 集群 kubeconfig 模板
# -----------------------------------------------------------------------------
# 使用方法：
#   1. 从外部 k3s 集群拷出 /etc/rancher/k3s/k3s.yaml
#   2. 把 server 改为 apiserver 容器可达的地址（不能用 127.0.0.1）
#   3. 重命名本文件为 external-kubeconfig.yaml，放到 deploy/ 目录
#
# 启动：docker compose -f docker-compose.dev.yml -f docker-compose.external.yml up -d
apiVersion: v1
kind: Config
clusters:
- name: default
  cluster:
    server: https://K3S_API_IP_OR_DOMAIN:6443
    # 把外部集群的证书数据贴在这里
    certificate-authority-data: REPLACE_WITH_CA_DATA
users:
- name: default
  user:
    client-certificate-data: REPLACE_WITH_CERT_DATA
    client-key-data: REPLACE_WITH_KEY_DATA
contexts:
- name: default
  context:
    cluster: default
    user: default
current-context: default
